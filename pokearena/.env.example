# Plantilla de variables de entorno para docker-compose.yml (sección 12).
# Copia este archivo a .env (Copy-Item .env.example .env) y completa los valores. .env NO se sube
# al repositorio (.gitignore); este archivo sí, y nunca lleva valores reales.

# --- Obligatorias -----------------------------------------------------------------------------
# Contraseña de PostgreSQL (la usan la base y las dos instancias de la API).
DB_PASSWORD=
# Secreto de firma de las credenciales propias: al menos 32 bytes. Para generar uno en PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
APP_JWT_SECRET=

# --- Opcionales -------------------------------------------------------------------------------
# Usuario de PostgreSQL (por defecto pokearena).
DB_USERNAME=pokearena
# Client id de Google (ID de cliente OAuth, tipo "Aplicación web", con http://localhost:8080 como
# origen autorizado). Vacío: el botón "Entrar con Google" queda deshabilitado.
APP_GOOGLE_CLIENT_ID=
# Identidades con rol ADMIN, formato proveedor:sub separadas por comas (por ejemplo google:1234567890).
APP_ADMIN_IDENTITIES=
# Perfil de Spring: vacío es producción; "dev" activa las sesiones de prueba (POST /api/v1/dev/sesiones).
SPRING_PROFILES_ACTIVE=
# Memoria máxima de Redis (caché del catálogo; al llenarse desaloja con allkeys-lru).
REDIS_MAXMEMORY=128mb
# Puerto del equipo donde Nginx publica la aplicación.
HTTP_PORT=8080
