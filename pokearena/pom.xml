<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>cr.ac.tec</groupId>
	<artifactId>pokearena</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>pokearena</name>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<!-- ArchUnit no lo administra Spring Boot: su versión se fija aquí, con nombre. -->
		<archunit.version>1.4.1</archunit.version>
		<!-- nimbus-jose-jwt tampoco lo administra Spring Boot 4. -->
		<nimbus-jose-jwt.version>10.10</nimbus-jose-jwt.version>
	</properties>
	<dependencies>
		<!-- Capa API: controladores REST y servidor embebido. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Persistencia: JdbcTemplate y transacciones (sección 3). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>

		<!-- Migraciones: Flyway aplica db/migration al arrancar (sección 6). Desde Flyway 10
		     el soporte de cada base va en un módulo aparte; este es el de PostgreSQL. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!-- Driver JDBC de PostgreSQL: solo se necesita al ejecutar, no al compilar. -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- JWT: solo firma y verificación de las credenciales propias (HS256). Las decisiones
		     (qué claims, vencimiento, roles) son del equipo, no de un framework (RES-01). Solo
		     se usa en infrastructure.identity; ArchUnit lo verifica. -->
		<dependency>
			<groupId>com.nimbusds</groupId>
			<artifactId>nimbus-jose-jwt</artifactId>
			<version>${nimbus-jose-jwt.version}</version>
		</dependency>

		<!-- Pruebas: JUnit 5, AssertJ y soporte de Spring. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Pruebas de arquitectura: reglas de dependencia de la sección 4.2. -->
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>${archunit.version}</version>
			<scope>test</scope>
		</dependency>

		<!-- Pruebas de integración: PostgreSQL real en un contenedor (Testcontainers 2.x,
		     versión administrada por Spring Boot) y su conexión automática con Spring.
		     No se usa testcontainers-junit-jupiter: el contenedor compartido se arranca a
		     mano en PostgresIntegrationTestBase, sin @Testcontainers ni @Container. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- Failsafe ejecuta las pruebas de integración (*IT) en la fase verify; Surefire
			     sigue ejecutando las unitarias (*Test). La configuración viene del parent. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
